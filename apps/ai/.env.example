# MongoDB Connection String
# Get this from MongoDB Atlas or your MongoDB provider
# Format: mongodb+srv://username:password@host/database?options
MONGODB_URI=mongodb+srv://username:password@host/database?retryWrites=true&w=majority

# Google Gemini API Key (for server-side)
# Get this from Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API=your-gemini-api-key-here

# Google Gemini API Key (for client-side - Next.js requires NEXT_PUBLIC_ prefix)
# Get this from Google AI Studio: https://makersuite.google.com/app/apikey
# REQUIRED for AI chat to work in browser
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# Qdrant Vector Database
# Required for RAG (vector search) functionality.
# Use http://localhost:6333 for local Docker Compose.
QDRANT_URL=http://localhost:6333
# Leave empty for local Qdrant; set only for an authenticated cluster.
QDRANT_API_KEY=

# Node Environment (set on the production Droplet)
NODE_ENV=production

# Port (set by Docker Compose on the Droplet)
PORT=3000
