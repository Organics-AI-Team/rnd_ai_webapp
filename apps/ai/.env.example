# MongoDB Connection String
# Get this from MongoDB Atlas or your MongoDB provider
# Format: mongodb+srv://username:password@host/database?options
MONGODB_URI=mongodb+srv://username:password@host/database?retryWrites=true&w=majority

# Required server-only governed model credential. Never expose it through a
# NEXT_PUBLIC_ variable or the browser application.
GEMINI_API_KEY=replace-with-runtime-secret

# Optional server-only governed external-search pair. Configure both or
# private-worker startup fails closed; omit both to keep web.search NOT_WIRED.
GOOGLE_SEARCH_API_KEY=replace-with-runtime-secret
GOOGLE_SEARCH_CSE_ID=replace-with-search-engine-id

# Private Qdrant connection used by the governed knowledge gateway.
QDRANT_URL=https://replace-with-private-qdrant-host
QDRANT_API_KEY=replace-with-runtime-secret

# Pinecone Vector Database API Key
# Get this from Pinecone console: https://www.pinecone.io/
# REQUIRED for RAG (vector search) functionality
# Note: Index names are configured in ai/config/rag-config.ts
#   - rawMaterialsAllAI → index: '002-rnd-ai'
#   - rawMaterialsAI → index: 'raw-materials-stock'
#   - salesRndAI → index: 'sales-rnd-ai'
PINECONE_API_KEY=replace-with-runtime-secret

# Node environment set by the droplet runtime in production
NODE_ENV=production

# Private worker/service port when an HTTP process is enabled
PORT=3000

# Private governed AI worker (server-only)
# The two price values are required decimal integers in micro-USD per one
# million tokens. Copy the approved values from the active commercial rate
# card; placeholders intentionally make worker startup fail closed.
AI_RATE_CARD_VERSION=commercial-2026-07-v1
AI_GEMINI_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=replace-with-approved-rate
AI_GEMINI_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=replace-with-approved-rate

# Runtime identity and bounded worker timings. Defaults shown here match the
# worker defaults; tune them only as one reviewed deployment configuration.
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_VERSION=v1
AI_EMBEDDING_DIMENSIONS=768
AI_RUN_TIMEOUT_MS=300000
AI_WORKER_LEASE_MS=60000
AI_WORKER_HEARTBEAT_INTERVAL_MS=15000
AI_WORKER_BACKOFF_MS=5000
AI_WORKER_MAX_ATTEMPTS=5
AI_WORKER_MAX_BACKOFF_MS=60000
AI_WORKER_POLL_MS=500
