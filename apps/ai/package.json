{
  "name": "@rnd-ai/ai",
  "version": "1.0.0",
  "description": "R&D AI Management - AI Backend Service",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx server/index.ts",
    "worker": "tsx server/worker.ts",
    "build:worker": "esbuild server/worker.ts --bundle --platform=node --format=cjs --target=node24 --alias:@/ai=. --external:@prisma/client --outfile=dist/server/worker.js",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/server/worker.js",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "migrate": "tsx scripts/migrate-to-mongo.ts",
    "create-sales-index": "node scripts/create-sales-ai-index.js",
    "index-sales-data": "tsx scripts/index-sales-data.ts",
    "index:qdrant": "tsx scripts/index-qdrant.ts",
    "check:qdrant": "tsx scripts/check-qdrant.ts",
    "setup:commercial-indexes": "tsx scripts/setup-commercial-indexes.ts",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "reconcile:clerk": "tsx server/services/provisioning/reconcile-clerk.ts",
    "migrate:clerk": "tsx scripts/migrate-legacy-users-to-clerk.ts",
    "tenant:audit": "tsx scripts/audit-tenant-ownership.ts",
    "tenant:backfill": "tsx scripts/backfill-tenant-ownership.ts",
    "tenant:verify": "tsx scripts/verify-tenant-ownership.ts",
    "import:reference": "tsx scripts/import/import-reference.ts",
    "import:materials": "tsx scripts/import/import-materials.ts",
    "import:formulas": "tsx scripts/import/import-formulas.ts",
    "import:all": "tsx scripts/import/import-all.ts",
    "grant:tool": "tsx scripts/grant-tool-allowlist.ts",
    "provision:tenant-ai": "tsx scripts/provision-tenant-ai.ts",
    "import:knowledge:market": "tsx scripts/import/import-knowledge-market.ts",
    "import:knowledge:formulas": "tsx scripts/import/import-knowledge-formulas.ts",
    "import:knowledge": "npm run import:knowledge:market && npm run import:knowledge:formulas",
    "repair:multi-org-suspensions": "tsx scripts/repair-multi-org-suspensions.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.11.5",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^0.3.43",
    "@langchain/google-genai": "^0.1.4",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^0.4.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pinecone-database/pinecone": "^6.1.2",
    "@qdrant/js-client-rest": "1.18.0",
    "@rnd-ai/server-config": "1.0.0",
    "@rnd-ai/shared-types": "1.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@trpc/server": "^11.6.0",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.1",
    "csv-parser": "^3.2.0",
    "langchain": "^0.3.9",
    "langchainhub": "^0.0.11",
    "mongodb": "6.21.0",
    "openai": "^6.7.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
