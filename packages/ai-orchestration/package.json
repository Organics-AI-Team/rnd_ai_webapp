  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint-mongodb": "1.4.0",
    "@rnd-ai/shared-types": "1.0.0",
    "decimal.js": "10.6.0",
    "mongodb": "6.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
