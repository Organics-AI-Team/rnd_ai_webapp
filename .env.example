# ============================================================================
# R&D AI Management - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# For monorepo: Also copy to apps/web/.env and apps/ai/.env as needed
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB Connection String (REQUIRED)
# Get this from DigitalOcean Managed MongoDB or your MongoDB provider
# Format: mongodb+srv://username:password@host/database?options
MONGODB_URI=mongodb+srv://username:password@host/database?retryWrites=true&w=majority

# Raw Materials Stock Database (Optional)
# If you have a separate database for raw materials stock
RAW_MATERIALS_REAL_STOCK_MONGODB_URI=mongodb+srv://username:password@host/raw_materials?retryWrites=true&w=majority

# ============================================================================
# AI API KEYS
# ============================================================================

# Google Gemini API Key (Server-side)
# Get this from Google AI Studio: https://makersuite.google.com/app/apikey
# REQUIRED for AI chat functionality
GEMINI_API_KEY=replace-with-runtime-secret

# Google Gemini API Key (Client-side)
# Next.js requires NEXT_PUBLIC_ prefix for client-side access
# REQUIRED for browser-based AI chat

# OpenAI API Key (Optional)
# Get this from OpenAI: https://platform.openai.com/api-keys
# Used for embeddings and optional LLM alternative
OPENAI_API_KEY=replace-with-runtime-secret

# OpenAI API Key (Client-side - Optional)

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================

# Qdrant runs in Docker Compose on the droplet. The compose network overrides
# this URL for the web container; localhost is useful for host-side scripts.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Pinecone API Key (legacy integrations only)
# Get this from Pinecone console: https://www.pinecone.io/
# Index names configured in ai/config/rag-config.ts:
#   - rawMaterialsAllAI → index: '002-rnd-ai'
#   - rawMaterialsAI → index: 'raw-materials-stock'
#   - salesRndAI → index: 'sales-rnd-ai'
PINECONE_API_KEY=replace-with-runtime-secret

# ============================================================================
# AUTHENTICATION (Clerk — invitation-only commercial identity)
# ============================================================================

# Clerk publishable key (public; inlined into the web bundle at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key

# Clerk secret key (server-only; never sent to the browser)
CLERK_SECRET_KEY=replace-with-runtime-secret

# Clerk webhook signing secret (svix) for identity/org projection ingress
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-runtime-secret

# Cutover flag: "true" resolves principals from Clerk sessions.
# The deploy script requires the three keys above when this is "true".
CLERK_CUTOVER=false

# Org role key mode: empty uses custom keys (org:manager/org:user);
# "built_in" maps to Clerk's org:admin/org:member instead.
CLERK_ORG_ROLE_MODE=

# ============================================================================
# GOVERNED AI RUN WORKER (private poll loop; docker compose service "worker")
# ============================================================================

# Gemini usage pricing in micro-USD per million tokens (REQUIRED — the worker
# fails closed at boot without cost accounting; integers only)
AI_GEMINI_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=1250000
AI_GEMINI_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=10000000

# Rate card identifier stamped on usage entries
AI_RATE_CARD_VERSION=commercial-2026-07-v1

# Embedding contract for tenant knowledge retrieval
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_VERSION=v1
AI_EMBEDDING_DIMENSIONS=768

# Optional worker tuning (defaults shown)
# AI_RUN_TIMEOUT_MS=300000
# AI_WORKER_POLL_MS=500
# AI_WORKER_MAX_ATTEMPTS=5

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Node Environment (development, production, test)
NODE_ENV=development

# Application Port (Web App)
PORT=3000

# AI Service Port (Backend)
AI_SERVICE_PORT=3001

# Web App URL (for AI service to call back)
WEB_APP_URL=http://localhost:3000

# AI Service URL (for web app to call)
AI_SERVICE_URL=http://localhost:3001

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Next.js Public tRPC URL
NEXT_PUBLIC_TRPC_URL=http://localhost:3000/api/trpc

# ============================================================================
# DEPLOYMENT CONFIGURATION (DigitalOcean Droplet)
# ============================================================================

# These are typically set by your deployment platform
# Uncomment and set if needed for manual deployment

# Next.js Telemetry (disable in production)
# NEXT_TELEMETRY_DISABLED=1

# Hostname (for Docker containers)
# HOSTNAME=0.0.0.0

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Enable/Disable Features (true/false)
# ENABLE_AI_CHAT=true
# ENABLE_VECTOR_SEARCH=true
# ENABLE_PDF_EXPORT=true

# Logging Level (error, warn, info, debug)
# LOG_LEVEL=info

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# These are only needed for local development

# Enable Debug Mode
# DEBUG=true

# Disable SSL Verification (for local MongoDB)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================================================
# NOTES
# ============================================================================
#
# Monorepo Structure:
# - Root .env: Shared variables for all apps
# - apps/web/.env: Web-specific variables (frontend)
# - apps/ai/.env: AI-specific variables (backend)
#
# Required Variables:
# - MONGODB_URI (must be set)
# - GEMINI_API_KEY (must be set)
# - GEMINI_API_KEY (must be set for web)
#
# Optional but Recommended:
# - OPENAI_API_KEY (for embeddings)
# - QDRANT_API_KEY when the Qdrant service requires authentication
# - Auth: Create first account at /signup (no env vars needed)
#
# Security Best Practices:
# - Never commit .env files to git
# - Use strong passwords
# - Rotate API keys regularly
# - Use different credentials for dev/staging/prod
#
# For more information:
# - See docs/DEPLOYMENT.md for deployment guides
# - See docs/MONOREPO_README.md for architecture details
#
# ============================================================================

# Optional server-only vector and web-search credentials
GOOGLE_SEARCH_API_KEY=replace-with-runtime-secret
GOOGLE_SEARCH_CSE_ID=replace-with-search-engine-id

# ============================================================================
# CLERK AUTHENTICATION (G1 — commercial identity)
# ============================================================================
# Clerk activates only when these are configured; CLERK_CUTOVER=false keeps
# the legacy session flow as the authorization source (G1 rollback lever).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-publishable-key
CLERK_SECRET_KEY=replace-with-runtime-secret
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-runtime-secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_CUTOVER=false
CLERK_ORG_ROLE_MODE=custom
