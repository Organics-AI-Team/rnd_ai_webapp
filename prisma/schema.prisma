  tenantId               String      @db.ObjectId
  actorProfileId         String      @db.ObjectId
  threadId               String?     @db.ObjectId
  agentKey               String
  deploymentId           String      @db.ObjectId
  agentDefinitionVersion String
  orchestratorVersion    String
  policyVersion          Int
  policySnapshot         Json
  promptVersionId        String      @db.ObjectId
  inputSchemaVersion     String
  outputSchemaVersion    String
  status                 AIRunStatus @default(queued)
  currentStage           String?
  correlationId          String      @unique
  idempotencyKey         String
  requestBudget          Json?
  usageSummary           Json?
  safeDecisionSummaries  Json?
  toolAuditEventIds      String[]
  provider               String?
  model                  String?
  startedAt              DateTime?
  completedAt            DateTime?
  retainedUntil          DateTime?
  errorCode              String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_runs")
}

model AIUsageLedger {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String           @db.ObjectId
  runId            String           @db.ObjectId
  actorProfileId   String           @db.ObjectId
  agentKey         String
  entryType        AIUsageEntryType
  operationType    String
  reservationId    String?          @db.ObjectId
  requestCount     Int              @default(0)
  provider         String?
  model            String?
  inputTokens      BigInt           @default(0)
  outputTokens     BigInt           @default(0)
  toolCalls        Int              @default(0)
  costMicrousd     BigInt           @default(0)
  adjustmentReason String?
  // billingPeriod is the UTC month bucket "YYYY-MM" used for quota rollups.
  billingPeriod    String
  occurredAt       DateTime         @default(now())
  idempotencyKey   String           @unique
  createdAt        DateTime         @default(now())

  @@index([tenantId, billingPeriod])
  @@index([tenantId, billingPeriod, actorProfileId])
  @@map("ai_usage_ledger")
}

model AIArtifact {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String           @db.ObjectId
  runId                  String           @db.ObjectId
  ownerProfileId         String           @db.ObjectId
  artifactType           String
  schemaVersion          String
  revision               Int              @default(1)
  status                 AIArtifactStatus @default(draft)
  content                Json
  contentHash            String
  validationResult       Json?
  sourceEvidenceIds      String[]
  parentArtifactId       String?          @db.ObjectId
  supersededByArtifactId String?          @db.ObjectId
  // G4.8d-iii: set when a confirmed artifact is committed to a Formula, so a
  // replayed commit_confirmed returns the same formula instead of duplicating it.
  confirmedFormulaId     String?          @db.ObjectId
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([tenantId, ownerProfileId, status])
  @@index([tenantId, status])
  @@map("ai_artifacts")
}

model AIApproval {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId             String           @db.ObjectId
  runId                String           @db.ObjectId
  artifactId           String?          @db.ObjectId
  checkpointId         String
  requestedByProfileId String           @db.ObjectId
  requiredPermission   String
  status               AIApprovalStatus @default(pending)
  decidedByProfileId   String?          @db.ObjectId
  decisionEdits        Json?
  decisionReason       String?
  requestedAt          DateTime         @default(now())
  expiresAt            DateTime?
  decidedAt            DateTime?
  idempotencyKey       String           @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([tenantId, status, requestedAt])
  @@map("ai_approvals")
}

/** Lease state of a durable run job claimed by the private worker (G4.9). */
enum AIRunJobStatus {
  available
  leased
  completed
  failed
}

/**
 * Durable work item that drives one governed run forward (G4.9). The gateway
 * enqueues a job in the same transaction as the AIRun; the private worker claims
 * it with a compare-and-set lease, heartbeats, and releases it. A crashed worker
 * lets the lease expire so the job becomes reclaimable — the run never depends on
 * a serverless request staying alive.
 */
model AIRunJob {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String         @db.ObjectId
  runId          String         @db.ObjectId
  command        String // "start" | "resume"
  status         AIRunJobStatus @default(available)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  attempts       Int            @default(0)
  availableAt    DateTime       @default(now())
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([runId, command])
  @@index([status, availableAt])
  @@map("ai_run_jobs")
}

/**
 * One ordered, versioned server event for a run (G4.9). Appended before being
 * sent, uniquely keyed by [runId, sequence] so a replay after Last-Event-ID is
 * exact and a retried append never duplicates. Holds the full AgentRunEventV1
 * payload for verbatim replay.
 */
model AIRunEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String   @db.ObjectId
  runId      String   @db.ObjectId
  sequence   Int
  type       String
  event      Json
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@unique([runId, sequence])
  @@index([tenantId, runId, sequence])
  @@map("ai_run_events")
}
