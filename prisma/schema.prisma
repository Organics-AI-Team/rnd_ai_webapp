// R&D AI Management — Prisma Schema (MongoDB)
// Generated from existing Zod schemas in apps/ai/lib/types.ts
// 20 collections mapped to Prisma models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USER MODELS
// ============================================

model Account {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  user     User?

  @@map("accounts")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  accountId String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model User {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  accountId      String     @unique @db.ObjectId
  organizationId String     @db.ObjectId
  email          String
  name           String
  role           UserRole   @default(admin)
  status         UserStatus @default(active)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  account      Account      @relation(fields: [accountId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Organization {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  credits             Float    @default(0)
  ownerId             String
  favoriteIngredients String[] @default([])
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users              User[]
  orders             Order[]
  formulas           Formula[]
  stockEntries       StockEntry[]
  products           Product[]
  creditTransactions CreditTransaction[]
  userLogs           UserLog[]
  chatThreads        ChatThread[]

  @@map("organizations")
}

enum UserRole {
  admin
  shipper
  shopper
}

enum UserStatus {
  active
  suspend
}

// ============================================
// PRODUCT/INVENTORY MODELS
// ============================================

model RawMaterial {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  rm_code      String  @unique
  trade_name   String
  inci_name    String?
  supplier     String?
  rm_cost      Float?
  company_name String?
  companies_id Int?
  benefits     String?
  details      String?
  usecase      String?

  @@map("raw_materials_console")
}

model Product {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId          String   @db.ObjectId
  actorProfileId    String?  @db.ObjectId
  organizationId    String   @db.ObjectId
  productCode       String
  productName       String
  description       String?
  price             Float
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(10)
  isActive          Boolean  @default(true)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([productCode])
  @@index([tenantId, isActive])
  @@index([tenantId, createdAt])
  @@map("products")
}

model StockEntry {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId       String      @db.ObjectId
  actorProfileId String?     @db.ObjectId
  organizationId String      @db.ObjectId
  materialId     String
  materialCode   String
  materialName   String
  quantityKg     Float
  unitPrice      Float
  totalCost      Float
  expirationDate DateTime
  batchNumber    String?
  supplier       String?
  notes          String?
  status         StockStatus @default(active)
  createdBy      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([materialId])
  @@index([status])
  @@index([expirationDate])
  @@index([tenantId, status])
  @@index([tenantId, materialId])
  @@map("stock_entries")
}

enum StockStatus {
  active
  expired
  depleted
}

// ============================================
// FORMULA MODELS
// ============================================

model Formula {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId            String              @db.ObjectId
  actorProfileId      String?             @db.ObjectId
  ownerProfileId      String?             @db.ObjectId
  organizationId      String              @db.ObjectId
  formulaCode         String?
  formulaName         String
  version             Int                 @default(1)
  client              String?
  targetBenefits      String[]            @default([])
  ingredients         FormulaIngredient[]
  totalAmount         Float?
  remarks             String?
  status              FormulaStatus       @default(draft)
  // AI generation metadata
  parentFormulaId     String?             @db.ObjectId
  referenceFormulaIds String[]            @default([])
  aiGenerated         Boolean             @default(false)
  generationPrompt    String?
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  comments     FormulaComment[]

  @@index([organizationId])
  @@index([formulaCode])
  @@index([parentFormulaId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("formulas")
}

type FormulaIngredient {
  materialId  String
  rm_code     String
  productName String
  inci_name   String?
  amount      Float
  percentage  Float?
  notes       String?
}

enum FormulaStatus {
  draft
  confirmed
  testing
  approved
  rejected
}

// ============================================
// FORMULA VERSION LOG — Immutable audit trail
// ============================================

model FormulaVersionLog {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId           String              @db.ObjectId
  formulaId          String              @db.ObjectId
  version            Int // 0 = pre-confirm draft, 1+ = confirmed versions
  previousVersion    Int? // version before this change (null for initial creation)
  changeType         FormulaChangeType // what happened
  updatedBySource    FormulaUpdateSource // ai or user
  updatedByUserId    String // user ID or "ai-system"
  updatedByName      String // display name
  status             String // formula status at this point in time
  ingredientSnapshot Json? // full ingredients array snapshot
  changelog          Json? // array of change entries
  remarks            String? // human-readable summary of this version
  createdAt          DateTime            @default(now())

  @@index([formulaId])
  @@index([formulaId, version])
  @@index([tenantId, formulaId])
  @@map("formula_version_logs")
}

enum FormulaChangeType {
  created // initial AI generation
  revised // AI revised based on feedback
  edited // user manually edited
  confirmed // user confirmed draft → version bumped
  status_changed // status transition (e.g. confirmed → testing)
}

enum FormulaUpdateSource {
  ai
  user
}

model FormulaComment {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId        String      @db.ObjectId
  actorProfileId  String?     @db.ObjectId
  formulaId       String      @db.ObjectId
  version         Int         @default(0) // formula version this comment belongs to
  userId          String
  userName        String
  content         String
  commentType     CommentType @default(feedback)
  parentCommentId String?     @db.ObjectId
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  formula Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@index([formulaId])
  @@index([formulaId, version])
  @@index([userId])
  @@index([parentCommentId])
  @@index([tenantId, formulaId])
  @@map("formula_comments")
}

enum CommentType {
  feedback
  suggestion
  approval
  rejection
  revision_note
  version_update
}

// ============================================
// ORDER MODELS
// ============================================

model Order {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId          String      @db.ObjectId
  actorProfileId    String?     @db.ObjectId
  organizationId    String      @db.ObjectId
  productId         String?
  productCode       String?
  productName       String
  price             Float
  quantity          Int
  channel           Channel
  customerName      String
  customerContact   String
  shippingAddress   String
  status            OrderStatus @default(pending)
  createdBy         String
  orderSource       OrderSource @default(admin)
  orderDate         String?
  // Shipping costs
  pickPackCost      Float       @default(0)
  bubbleCost        Float       @default(0)
  paperInsideCost   Float       @default(0)
  cancelOrderCost   Float       @default(0)
  codCost           Float       @default(0)
  boxCost           Float       @default(0)
  deliveryFeeCost   Float       @default(0)
  totalShippingCost Float       @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([channel])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

enum OrderStatus {
  pending
  processing
  sent_to_logistic
  delivered
  cancelled
}

enum Channel {
  line
  shopee
  lazada
  other
}

enum OrderSource {
  admin
  client
}

// ============================================
// CREDIT TRANSACTION MODEL
// ============================================

model CreditTransaction {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId         String                @db.ObjectId
  actorProfileId   String?               @db.ObjectId
  organizationId   String                @db.ObjectId
  organizationName String
  type             CreditTransactionType
  amount           Float
  balanceBefore    Float
  balanceAfter     Float
  description      String
  orderId          String?
  performedBy      String?
  performedByName  String?
  createdAt        DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([tenantId, createdAt])
  @@map("credit_transactions")
}

enum CreditTransactionType {
  add
  deduct
  adjust
  refund
}

// ============================================
// LOG MODELS
// ============================================

model ProductLog {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId       String        @db.ObjectId
  actorProfileId String?       @db.ObjectId
  date           String
  time           String
  productId      String
  productCode    String
  productName    String
  action         ProductAction
  quantityChange Float?
  previousStock  Float?
  newStock       Float?
  userId         String
  userName       String?
  organizationId String
  refId          String?
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([tenantId, productId])
  @@map("product_logs")
}

enum ProductAction {
  create
  update
  add_stock
  reduce_stock
  delete
}

model UserLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId       String?  @db.ObjectId
  actorProfileId String?  @db.ObjectId
  scope          String? // "platform" or "tenant"; tenantId required for tenant events
  date           String
  time           String
  userId         String
  userName       String?
  activity       String
  refId          String?
  organizationId String?  @db.ObjectId
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([tenantId, createdAt])
  @@map("user_logs")
}

// ============================================
// AI CONVERSATION MODELS
// ============================================

model Conversation {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId       String                @db.ObjectId
  actorProfileId String?               @db.ObjectId
  ownerProfileId String?               @db.ObjectId
  userId         String
  sessionId      String?
  messages       ConversationMessage[]
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([tenantId, ownerProfileId])
  @@index([tenantId, createdAt])
  @@map("conversations")
}

type ConversationMessage {
  role      String
  content   String
  timestamp DateTime @default(now())
}

model Feedback {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId       String   @db.ObjectId
  actorProfileId String?  @db.ObjectId
  ownerProfileId String?  @db.ObjectId
  responseId     String?
  userId         String?
  rating         Int?
  comment        String?
  category       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([responseId])
  @@index([tenantId, createdAt])
  @@map("feedback")
}

model AiResponse {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId         String   @db.ObjectId
  ownerProfileId   String?  @db.ObjectId
  conversationId   String?
  query            String
  response         String
  model            String?
  toolsUsed        String[] @default([])
  processingTimeMs Int?
  feedbackScore    Float?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([conversationId])
  @@index([tenantId, createdAt])
  @@map("ai_responses")
}

// ============================================
// CHAT THREAD MODELS (Persistent Conversations)
// ============================================

model ChatThread {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId       String    @db.ObjectId
  actorProfileId String?   @db.ObjectId
  ownerProfileId String?   @db.ObjectId
  organizationId String    @db.ObjectId
  userId         String    @db.ObjectId
  agentType      AgentType
  title          String
  messageCount   Int       @default(0)
  lastMessageAt  DateTime  @default(now())
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  messages     ChatMessage[]

  @@index([organizationId, agentType])
  @@index([userId, agentType])
  @@index([lastMessageAt])
  @@index([tenantId, ownerProfileId])
  @@index([tenantId, createdAt])
  @@map("chat_threads")
}

enum AgentType {
  raw_materials_ai
  sales_rnd_ai
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId  String   @db.ObjectId
  threadId  String   @db.ObjectId
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([tenantId, threadId])
  @@map("chat_messages")
}

// ============================================
// PRICE CALCULATION MODEL
// ============================================

model PriceCalculation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  // G2.2 expansion: nullable until the backfill (G2.3/G2.4) verifies; organizationId kept for dual-read.
  tenantId        String   @db.ObjectId
  actorProfileId  String?  @db.ObjectId
  organizationId  String
  formulaId       String?
  calculationType String
  ingredients     Json
  totalCost       Float
  markup          Float?
  sellingPrice    Float?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([formulaId])
  @@index([tenantId, createdAt])
  @@map("price_calculations")
}

// ============================================
// COMMERCIAL IDENTITY & TENANCY PROJECTIONS (G1.2)
// Clerk owns identity/sessions/orgs; these are internal projections with
// stable ObjectIds and explicit lifecycle status. Nullable external IDs use
// partial unique MongoDB indexes created by setup-commercial-indexes.ts —
// never Prisma @unique — because multiple provisioning records may be null.
// ============================================

enum UserProfileStatus {
  active
  suspended
  deleted
}

enum PlatformRole {
  super_admin
  admin
}

enum TenantType {
  university
}

enum TenantStatus {
  provisioning
  active
  suspended
  repair_required
  deleted
}

enum TenantRole {
  manager
  user
}

enum MembershipStatus {
  invited
  active
  suspended
  revoked
}

model UserProfile {
  id               String                       @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId      String                       @unique
  legacyAccountId  String?                      @db.ObjectId
  primaryEmail     String
  displayName      String
  platformRole     PlatformRole?
  status           UserProfileStatus            @default(active)
  clerkSyncVersion Int                          @default(0)
  clerkSyncedAt    DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  memberships      TenantMembershipProjection[]
  createdTenants   Tenant[]                     @relation("TenantCreator")

  @@index([primaryEmail])
  @@map("user_profiles")
}

model Tenant {
  id                   String                       @id @default(auto()) @map("_id") @db.ObjectId
  clerkOrganizationId  String?
  legacyOrganizationId String?                      @db.ObjectId
  slug                 String                       @unique
  name                 String
  type                 TenantType                   @default(university)
  status               TenantStatus                 @default(provisioning)
  planKey              String
  dataResidencyRegion  String
  provisioningKey      String                       @unique
  createdByProfileId   String                       @db.ObjectId
  activatedAt          DateTime?
  suspendedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  createdBy            UserProfile                  @relation("TenantCreator", fields: [createdByProfileId], references: [id])
  memberships          TenantMembershipProjection[]
  invitations          TenantInvitationProjection[]

  @@index([status])
  @@map("tenants")
}

model TenantMembershipProjection {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  clerkMembershipId String?
  tenantId          String           @db.ObjectId
  userProfileId     String           @db.ObjectId
  tenantRole        TenantRole
  status            MembershipStatus @default(invited)
  clerkSyncVersion  Int              @default(0)
  clerkSyncedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  userProfile       UserProfile      @relation(fields: [userProfileId], references: [id])

  @@unique([tenantId, userProfileId])
  @@index([userProfileId, status])
  @@map("tenant_membership_projections")
}

model TenantInvitationProjection {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  clerkInvitationId  String           @unique
  tenantId           String           @db.ObjectId
  emailNormalized    String
  tenantRole         TenantRole
  status             MembershipStatus @default(invited)
  invitedByProfileId String           @db.ObjectId
  expiresAt          DateTime?
  clerkSyncedAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId, emailNormalized, status])
  @@map("tenant_invitation_projections")
}

model SupportAccessGrant {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String    @db.ObjectId
  platformProfileId   String    @db.ObjectId
  reason              String
  permissions         String[]
  requestedAt         DateTime  @default(now())
  approvedByProfileId String?   @db.ObjectId
  approvedAt          DateTime?
  expiresAt           DateTime?
  revokedAt           DateTime?
  correlationId       String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, expiresAt])
  @@index([platformProfileId, expiresAt])
  @@map("support_access_grants")
}

// ============================================
// TENANT AI CONTROL PLANE (G3.1)
// Every AI run pins immutable policy, deployment, prompt, and schema
// versions. Usage and approvals are append-only ledgers reconciled by
// idempotency keys. Monetary amounts are integer micro-USD BigInt because
// the MongoDB connector does not support Prisma Decimal.
// ============================================

enum AIProfileStatus {
  active
  disabled
}

enum AgentDeploymentStatus {
  draft
  active
  retired
}

enum PromptStatus {
  draft
  approved
  active
  retired
}

enum KnowledgeScope {
  platform
  tenant
}

enum KnowledgeVisibility {
  managers
  all_members
}

enum KnowledgeSourceStatus {
  pending
  quarantined
  indexing
  ready
  failed
  deleted
}

enum AIRunStatus {
  queued
  running
  waiting_clarification
  waiting_approval
  completed
  partial
  failed
  cancelled
}

enum AIUsageEntryType {
  reservation
  actual
  release
  adjustment
}

enum AIApprovalStatus {
  pending
  approved
  rejected
  expired
}

enum AIArtifactStatus {
  draft
  pending_review
  confirmed
  rejected
  superseded
}

model TenantAIProfile {
  id                              String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                        String          @unique @db.ObjectId
  status                          AIProfileStatus @default(active)
  planKey                         String
  policyVersion                   Int             @default(1)
  allowedProviders                String[]
  allowedModels                   String[]
  allowedTools                    String[]
  monthlyRequestLimit             BigInt
  monthlyTokenLimit               BigInt
  monthlyCostLimitMicrousd        BigInt
  perUserMonthlyRequestLimit      BigInt
  perUserMonthlyTokenLimit        BigInt
  perUserMonthlyCostLimitMicrousd BigInt
  perRunTokenLimit                BigInt
  perRunCostLimitMicrousd         BigInt
  maxConcurrentRuns               Int
  maxIterations                   Int
  defaultLocale                   String
  retentionDays                   Int
  allowWebSearch                  Boolean         @default(false)
  allowTenantKnowledge            Boolean         @default(true)
  knowledgeStorageLimitBytes      BigInt
  reviewPolicy                    Json?
  qualityPolicy                   Json?
  createdByProfileId              String          @db.ObjectId
  updatedByProfileId              String?         @db.ObjectId
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt

  @@index([tenantId, status])
  @@map("tenant_ai_profiles")
}

model AgentDeployment {
  id                     String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String                @db.ObjectId
  agentKey               String
  revision               Int
  status                 AgentDeploymentStatus @default(draft)
  agentDefinitionVersion String
  orchestratorVersion    String
  promptVersionId        String                @db.ObjectId
  allowedProviders       String[]
  allowedModels          String[]
  temperature            Float?
  maxOutputTokens        Int?
  modelRouting           Json?
  toolAllowlist          String[]
  approvalRules          Json?
  featureFlags           Json?
  inputSchemaVersion     String
  outputSchemaVersion    String
  activatedByProfileId   String?               @db.ObjectId
  activatedAt            DateTime?
  retiredAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([tenantId, agentKey, revision])
  @@index([tenantId, agentKey, status])
  @@map("agent_deployments")
}

model PromptVersion {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  scope                 KnowledgeScope
  // scopeKey is the literal "platform" or the tenant ObjectId string; the
  // repository validates that scopeKey and tenantId agree.
  scopeKey              String
  tenantId              String?        @db.ObjectId
  promptKey             String
  semanticVersion       String
  revision              Int
  status                PromptStatus   @default(draft)
  contentHash           String
  content               String
  variables             String[]
  parentPromptVersionId String?        @db.ObjectId
  evaluationResultId    String?        @db.ObjectId
  createdByProfileId    String         @db.ObjectId
  approvedByProfileId   String?        @db.ObjectId
  activatedAt           DateTime?
  retiredAt             DateTime?
  createdAt             DateTime       @default(now())

  @@unique([scopeKey, promptKey, revision])
  @@index([scopeKey, promptKey, status])
  @@map("prompt_versions")
}

model KnowledgeSource {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  scope              KnowledgeScope
  // scopeKey mirrors PromptVersion; the repository validates platform scope
  // has no tenantId and tenant scope carries the matching ObjectId string.
  scopeKey           String
  tenantId           String?               @db.ObjectId
  sourceType         String
  name               String
  objectKey          String?
  visibility         KnowledgeVisibility   @default(managers)
  allowedRoles       String[]
  contentHash        String
  sourceVersion      Int                   @default(1)
  byteSize           BigInt                @default(0)
  provenance         Json?
  consentBasis       String?
  freshnessDate      DateTime?
  retainedUntil      DateTime?
  embeddingModel     String?
  embeddingVersion   String?
  status             KnowledgeSourceStatus @default(pending)
  errorCode          String?
  createdByProfileId String                @db.ObjectId
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([scope, status])
  @@index([tenantId, status])
  @@map("knowledge_sources")
}

model AIRun {
